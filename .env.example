# ── LiveKit ────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Google AI (Gemini LLM + Gemini Live API + Gemini TTS) ─────────────────
GOOGLE_API_KEY=your_google_ai_studio_key

# ── Google Cloud (STT via Chirp, Cloud TTS) ───────────────────────────────
# Download your service account JSON from Google Cloud Console
# Cloud console → IAM & Admin → Service Accounts → Create Key → JSON
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json

# ── Tavily (web search / research) ────────────────────────────────────────
TAVILY_API_KEY=your_tavily_key

# ── OpenWeather (weather tool) ────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_key

# ── Email (jarvis_email.py) ───────────────────────────────────────────────
EMAIL=your_gmail_address@gmail.com
EMAIL_PASSWORD=your_gmail_app_password   # Use an App Password, not your real password
